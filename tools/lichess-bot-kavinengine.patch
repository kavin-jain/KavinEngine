+def reconcile_games(li: lichess.Lichess, active_games: dict[str, str], suspects: set[str], pool: POOL_TYPE,
+                    play_game_args: PlayGameArgsType, startup_correspondence_games: list[str]) -> None:
+    """
+    KavinEngine patch (2026-10-09): make the local game slots agree with lichess.org, which is the truth.
+
+    active_games can drift from the real games (a game thread that quit while the game went on, a repeated gameStart, an
+    accepted challenge whose game never started), and every drift either loses a game on time, plays two games at once
+    or leaves the bot idle with a slot that never frees. Runs once a minute:
+    - a game lichess lists as ongoing with no running thread gets a thread (play_game resumes from the full state);
+    - a slot for a game lichess does not list, with no running thread, is freed once it has looked stale on two runs
+      in a row (a just-accepted challenge has a minute to start).
+    """
+    ongoing = li.get_ongoing_games()
+    if ongoing is None:  # API error: keep everything until the next run
+        return
+    live = {game["gameId"]: game for game in ongoing
+            if game["speed"] != "correspondence" and game["gameId"] not in startup_correspondence_games}
+    for game_id, game in live.items():
+        if game_id not in running_games:
+            logger.warning(f"Reconcile: {game_id} is being played on lichess without a game thread; resuming it")
+            start_game_thread(active_games, game_id, game["opponent"]["username"], play_game_args, pool)
+    stale = {game_id for game_id in active_games if game_id not in live and game_id not in running_games}
+    freed = stale & suspects
+    for game_id in freed:
+        logger.warning(f"Reconcile: freeing the slot of {game_id}, which lichess does not list as ongoing")
+        active_games.pop(game_id, None)
+        log_proc_count("Freed", active_games)
+    suspects.clear()
+    suspects.update(stale - freed)  # first-time stale slots get one more minute
+
+
